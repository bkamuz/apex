{
  "name": "apex-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Apex: drive a headless or live Apex model from Cursor, Claude Desktop or any MCP client.",
  "type": "module",
  "bin": {
    "apex-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test test/",
    "house": "npm run build && node scripts/house-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
